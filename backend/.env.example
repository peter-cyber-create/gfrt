# Copy to backend/.env and adjust. Never commit real secrets.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://musooka:musooka_dev_only@127.0.0.1:5434/musooka_dev?schema=public
SESSION_SECRET=replace-with-long-random-string-min-32-chars
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGIN=http://127.0.0.1:5173,http://127.0.0.1:5175
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
SESSION_DAYS=7
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20

# Email (mock for dev/test; smtp required in staging/production)
EMAIL_PROVIDER=mock
PASSWORD_RESET_URL_BASE=http://127.0.0.1:5173/reset-password
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@staging.example

# Attachment storage (must NOT be web/static root)
STORAGE_ROOT=./data/uploads

# Optional override used by tests (otherwise tests default to port 5435)
# DATABASE_URL_TEST=postgresql://musooka:musooka_dev_only@127.0.0.1:5435/musooka_test?schema=public

# Test-only transaction failure injection (NODE_ENV=test only)
# FORCE_TX_FAILURE=approve_after_status
