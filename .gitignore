# Environment / secrets — never commit real values
.env
.env.*
!.env.example
!.env.production.example
!**/.env.example
!**/.env.production.example
backend/.env
clone/.env
infra/staging/.env
infra/production/.env

# Dependencies & build output
node_modules/
backend/node_modules/
clone/node_modules/
backend/dist/
clone/dist/
dist/
build/
coverage/

# Playwright / browser automation
.playwright/
playwright-report/
test-results/
playwright/.auth/
browser-state/
auth/

# TLS / keys / certs
*.pem
*.key
*.crt
*.p12
*.pfx
infra/staging/certs/
secrets/
certificates/

# Database dumps / backups
*.sql
*.dump
*.sql.gz
*.dump.gz
*.tar
*.tar.gz
*.enc
!backend/prisma/migrations/**/*.sql
data/staging-backups/
backups/

# Uploads / runtime storage
backend/storage/
**/data/uploads/
storage/
uploads/

# Generated reports / recon / staging run artifacts (regenerated by scripts)
data/*.json
data/*.html
data/live/
screenshots/
!data/fixtures/
!data/fixtures/**

# Logs & OS
*.log
.DS_Store

# Local smoke / host-specific
data/production-smoke-report.json

# Local tooling
.vscode/
.idea/
