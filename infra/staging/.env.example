# Staging lab only — copy to infra/staging/.env (gitignored).
# staging-up.sh can generate secrets into .env for local use.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_OPENSSL_RAND
POSTGRES_DB=musooka_staging
POSTGRES_APP_PASSWORD=REPLACE_WITH_OPENSSL_RAND

SESSION_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32_MIN

# Staging presentation accounts only — never reuse in production
STAGING_SEED_PASSWORD=CHANGE_ME_STAGING_ONLY

BACKUP_ENCRYPTION_KEY=REPLACE_WITH_OPENSSL_RAND_HEX

# Optional overrides (compose sets most API vars)
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_FROM=staging@gfrt.local
