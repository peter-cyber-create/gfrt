# Copy to .env locally — NEVER commit .env with real secrets.
# staging-up.sh generates .env from this template with random values.

# PostgreSQL superuser (init only)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_OPENSSL_RAND
POSTGRES_DB=musooka_staging

# Least-privilege application role (created by db-init)
POSTGRES_APP_PASSWORD=REPLACE_WITH_OPENSSL_RAND

# API
SESSION_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32_MIN
# Must be >= 32 chars in staging; must NOT contain: replace, change-me, local-dev

STAGING_SEED_PASSWORD=REPLACE_WITH_OPENSSL_RAND_OR_SET_MANUALLY

# Backup / DR scripts
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_OPENSSL_RAND_HEX

# Optional overrides (compose sets most API vars)
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_FROM=staging@musooka.local
