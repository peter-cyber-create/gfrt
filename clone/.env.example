# Frontend environment — never commit real secrets.
# Vite VITE_* values are embedded in the browser bundle (public after build).

# --- Demo / GitHub Pages (default safe mode) ---
VITE_APP_NAME=Global Fund Requisition Performance Tracker
VITE_DEMO_MODE=true
VITE_DATA_SOURCE=mock
# Optional legacy single-account fallback used by older Playwright defaults:
VITE_DEMO_EMAIL=admin@gmail.com
VITE_DEMO_PASSWORD=123456
# Presentation quick-login (built into demo auth; not env secrets):
#   admin / Admin123!
#   reviewer / Review123!
#   user / User123!
VITE_STAGING_QUICK_LOGIN=false
VITE_STAGING_PRESENTATION_RESET=false

# Base path for static hosting. Local Vite default is "/".
# GitHub Pages project site for peter-cyber-create/gfrt: /gfrt/
# VITE_BASE_PATH=/
# VITE_BASE_PATH=/gfrt/

# --- API mode (external API only — GitHub Pages does NOT host the Express API) ---
VITE_API_BASE_URL=

# Do NOT put DATABASE_URL, SESSION_SECRET, SMTP_*, or other private credentials here.
