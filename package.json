{
  "name": "musooka-recon",
  "version": "1.0.0",
  "description": "Musooka presentation clone + production-foundation API (does not modify musooka.site)",
  "main": "index.js",
  "scripts": {
    "save-session": "node scripts/save-session.js",
    "crawl": "node scripts/crawl.js",
    "capture": "node scripts/capture.js",
    "validate": "node scripts/validate-clone.js",
    "restore:check": "node scripts/restore-check.js",
    "production:recon": "node scripts/production-recon.js",
    "reconcile": "node scripts/reconcile.js",
    "clone:dev": "npm --prefix clone run dev -- --host 127.0.0.1 --port 5173",
    "clone:build": "npm --prefix clone run build",
    "clone:preview": "npm --prefix clone run preview -- --host 127.0.0.1 --port 4173",
    "api:dev": "npm --prefix backend run dev",
    "api:test": "npm --prefix backend test",
    "api:typecheck": "npm --prefix backend run typecheck",
    "db:up": "docker compose -f infra/docker-compose.yml up -d db db_test",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:seed": "npm --prefix backend run db:seed",
    "db:seed:presentation": "npm --prefix backend run db:seed:presentation",
    "db:seed:staging": "npm --prefix backend run db:seed:staging",
    "test:backend": "npm --prefix backend test",
    "test:frontend": "npm run validate",
    "ci:local": "npm run api:typecheck && npm run test:backend && npm run clone:build",
    "backup:test": "bash scripts/backup-restore-test.sh",
    "staging:smoke": "node scripts/staging-smoke.js",
    "api:smoke": "node scripts/api-mode-smoke.js",
    "migration:dry-run": "node scripts/migration-dry-run.js",
    "perf:baseline": "node scripts/perf-baseline.js",
    "staging:up": "bash scripts/staging-up.sh",
    "staging:down": "bash scripts/staging-down.sh",
    "staging:e2e": "node scripts/staging-e2e.js",
    "staging:consistency": "node scripts/staging-consistency.js",
    "staging:security": "node scripts/staging-security-check.js",
    "staging:backup": "bash scripts/staging-encrypted-backup.sh",
    "staging:dr": "bash scripts/staging-dr-exercise.sh",
    "staging:perf": "node scripts/staging-perf.js",
    "staging:reset-e2e": "node scripts/staging-password-reset-e2e.js",
    "staging:multirole": "node scripts/staging-multirole.js",
    "staging:functional-audit": "node scripts/staging-functional-audit.js",
    "production:smoke": "node scripts/production-smoke.js",
    "production:config-check": "node scripts/production-config-check.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "dotenv": "^17.4.2",
    "playwright": "^1.63.0"
  }
}
