# Production configuration example — placeholders only. Never commit real secrets.
NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://musooka_app:CHANGE_ME_STRONG_PASSWORD@db.internal:5432/musooka_prod?schema=public
SESSION_SECRET=CHANGE_ME_TO_OPENSSL_RAND_HEX_AT_LEAST_32_CHARS_LONG
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
