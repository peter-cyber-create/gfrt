# Production configuration — placeholders only. Never commit real secrets.
# Copy to a secure secret store / infra/production/.env (gitignored).

NODE_ENV=production
PORT=4000

# PostgreSQL — app role, not superuser. No public exposure of this host.
DATABASE_URL=postgresql://musooka_app:CHANGE_ME_STRONG_PASSWORD@db.internal:5432/musooka_prod?schema=public

# Session / cookies
SESSION_SECRET=replace-me-with-openssl-rand-hex-at-least-32-chars-long
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Browser origins allowed to call the API (comma-separated HTTPS origins; no localhost)
CORS_ORIGIN=https://app.example.org

# Public URLs (documentation / operators; API uses PASSWORD_RESET_URL_BASE)
FRONTEND_URL=https://app.example.org
API_URL=https://app.example.org

# Email — SMTP only in production (mock / Mailpit forbidden)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USER=change-me
SMTP_PASS=change-me
SMTP_FROM=noreply@example.org
PASSWORD_RESET_URL_BASE=https://app.example.org/password/reset/confirm

# Attachments — path outside web/static root (or mounted volume)
STORAGE_ROOT=/var/lib/gfrt/uploads

# Optional rate-limit tuning
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=200
# AUTH_RATE_LIMIT_MAX=20
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCK_MINUTES=15
# SESSION_DAYS=7

# Forbidden in production (do not set):
# EMAIL_PROVIDER=mock
# FORCE_TX_FAILURE=...
# STAGING_ALLOW_PRESENTATION_RESET=true
# VITE_DEMO_MODE=true
# VITE_STAGING_QUICK_LOGIN=true
# VITE_STAGING_DEMO_PASSWORD=...
# VITE_STAGING_PRESENTATION_RESET=true

# Frontend production build-time (bake into static assets at image build)
VITE_DEMO_MODE=false
VITE_DATA_SOURCE=api
# Empty = same-origin /api via reverse proxy
VITE_API_BASE_URL=
VITE_STAGING_QUICK_LOGIN=false
VITE_STAGING_PRESENTATION_RESET=false
